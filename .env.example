# ==============================================================================
# HİZMETCHATBOT ORTAM DEĞİŞKENLERİ (.env.example)
# Modüler, Hafif ve Sıfır Dış Bağımlılık Mimarisi
# ==============================================================================

# Sunucu & Dashboard
PORT=3000
NODE_ENV=development
ADMIN_SECRET_KEY=hizmet_admin_change_me_in_production

# Veritabanı (Node.js Native SQLite - WAL Mode)
DATABASE_PATH=./data/hizmetchatbot.sqlite

# ------------------------------------------------------------------------------
# 1. KANAL BAĞIMSIZLIĞI (Channel-Agnostic Settings)
# ------------------------------------------------------------------------------
# Aktif Kanal: 'whatsapp_baileys' | 'whatsapp_evolution' | 'telegram' | 'mock'
DEFAULT_CHANNEL=mock

# WhatsApp Baileys Ayarları
WA_AUTH_FOLDER=./data/baileys_auth_info

# Telegram Bot Ayarları
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ------------------------------------------------------------------------------
# 2. MODEL BAĞIMSIZ LLM BEYİN KATMANI (LLM-Agnostic Settings)
# ------------------------------------------------------------------------------
# Sağlayıcı: 'openrouter' | 'ollama' | 'vllm' | 'rule_based'
LLM_PROVIDER=rule_based

# OpenRouter Ayarları
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Yerel Ollama Ayarları ($0 Maliyetli Local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# 3. GOOGLE CALENDAR ENTEGRASYONU (2 Usta Servis Hesabı)
# ------------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/google_credentials.json
GOOGLE_CALENDAR_ID_TECH_1=mehmet_usta_kadikoy@group.calendar.google.com
GOOGLE_CALENDAR_ID_TECH_2=ali_usta_uskudar@group.calendar.google.com

# ------------------------------------------------------------------------------
# 4. SANAL POS & ÖDEME LİNKİ SAĞLAYICISI
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=mock_pos
PAYMENT_BASE_URL=http://localhost:3000/pay
PAYMENT_WEBHOOK_SECRET=pos_webhook_secret_key

# ------------------------------------------------------------------------------
# 5. HUKUK & KVKK AYARLARI
# ------------------------------------------------------------------------------
KVKK_SPAM_COOLDOWN_HOURS=4
KVKK_AUTO_PURGE_LOCATION_HOURS=24
